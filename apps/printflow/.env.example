# PrintFlow app configuration (task 0.12)
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only the publishable/anon key belongs here. It is safe in a client because
# RLS (migration 004) enforces access -- the key identifies the project, it does
# not grant permission. The service_role key bypasses RLS entirely and must
# never appear in an app bundle.
#
# Local development: run `supabase status` and copy the API URL and anon key.
# The local values are the CLI's fixed defaults, identical on every machine.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
